# --- Interactive tool page (frontend "Connect GitHub" on /tool) ---
# Optional. Without it, that tool's GitHub MCP calls are unauthenticated
# (60/hr rate limit, public repos only). Needs no scopes for public reads.
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- GitHub App (Stage 2+: OAuth login, webhooks, automated PR/Issue creation) ---
# Register a GitHub App at https://github.com/settings/apps/new -- see
# README "Setting up the GitHub App" for exactly what to fill in. Nothing
# below this line works until all of these are set.
GITHUB_APP_ID=
# Paste the downloaded .pem private key as ONE line with \n for newlines,
# e.g. "-----BEGIN RSA PRIVATE KEY-----\nMIIEown...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Must match the "Callback URL" configured on the App.
GITHUB_APP_CALLBACK_URL=http://localhost:4000/auth/github/callback
# Must match the "Webhook secret" configured on the App.
GITHUB_WEBHOOK_SECRET=

# --- AI fixes: Check pipeline tab + webhook auto-fix (llmClient.js) ---
# Google Gemini is the server default for every "Generate fix" / "Suggest a
# fix" call and for the GitHub App webhook path (fixProposal.js).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Defaults to gemini-3.8-flash. Google retires models on a schedule -- if
# requests fail with 404 "model not found", pick a current stable model from
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# Optional: low | medium | high. Lower = faster/cheaper, higher = more careful.
# Leave unset to use the model's default. (gemini-3.8-flash rejects "minimal".)
# GEMINI_THINKING_LEVEL=low
# Tried in order when the main model returns 503/429/500 (high demand). Comma-separated.
# "-lite"/"-latest"/"-preview" variants tend to have far more spare capacity.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.7-flash,gemini-3.1-flash-lite,gemini-3.5-flash

# --- Misc ---
# Signs the login session cookie. Any random string; change it for real use.
SESSION_SECRET=
# Where the OAuth callback redirects back to after login -- also the only
# origin the backend's CORS policy allows (with credentials), since the
# personal-token connection is a single process-wide value, not per-session.
FRONTEND_URL=http://localhost:3000
